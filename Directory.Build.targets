<Project>
  <!--
    Machine-readable bridge from Nerdbank.GitVersioning to PowerShell,
    Doxygen and packaging.

    GetBuildVersion is the NBGV target that initializes the version
    properties consumed below.

    The PowerShell version-probe script creates the destination directory
    before this target is invoked.
  -->
  <Target Name="WriteLotSizingDataModelVersion"
          DependsOnTargets="GetBuildVersion">

    <PropertyGroup>
      <LotSizingVersionOutput Condition="'$(LotSizingVersionOutput)' == ''">$(BaseIntermediateOutputPath)LotSizingDataModel.version.txt</LotSizingVersionOutput>
    </PropertyGroup>

    <ItemGroup>
      <_LotSizingVersionLine Include="AssemblyVersion=$(AssemblyVersion)" />
      <_LotSizingVersionLine Include="AssemblyFileVersion=$(AssemblyFileVersion)" />
      <_LotSizingVersionLine Include="AssemblyInformationalVersion=$(AssemblyInformationalVersion)" />
      <_LotSizingVersionLine Include="BuildVersion=$(BuildVersion)" />
      <_LotSizingVersionLine Include="BuildVersionSimple=$(BuildVersionSimple)" />
      <_LotSizingVersionLine Include="BuildVersion3Components=$(BuildVersion3Components)" />
      <_LotSizingVersionLine Include="GitCommitId=$(GitCommitId)" />
      <_LotSizingVersionLine Include="GitCommitIdShort=$(GitCommitIdShort)" />
      <_LotSizingVersionLine Include="GitVersionHeight=$(GitVersionHeight)" />
      <_LotSizingVersionLine Include="MajorMinorVersion=$(MajorMinorVersion)" />
      <_LotSizingVersionLine Include="PackageVersion=$(PackageVersion)" />
      <_LotSizingVersionLine Include="NuGetPackageVersion=$(NuGetPackageVersion)" />
      <_LotSizingVersionLine Include="PublicRelease=$(PublicRelease)" />
    </ItemGroup>

    <WriteLinesToFile File="$(LotSizingVersionOutput)"
                      Lines="@(_LotSizingVersionLine)"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>
</Project>
