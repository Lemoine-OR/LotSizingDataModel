{
  "schemaVersion": 1,
  "catalogVersion": "1.0",
  "severities": [
    "Information",
    "Warning",
    "Error",
    "Fatal"
  ],
  "services": [
    {
      "id": "supply-chain-validator",
      "layer": "Core",
      "question": "Are domain data structurally, referentially and locally consistent?",
      "solverAllowed": false
    },
    {
      "id": "instance-model-checker",
      "layer": "Instance",
      "question": "Does the instance describe a scientifically meaningful lot-sizing problem?",
      "solverAllowed": false
    },
    {
      "id": "instance-feasibility-analyzer",
      "layer": "Checker",
      "question": "Does at least one feasible solution exist?",
      "solverAllowed": true
    },
    {
      "id": "solution-checker",
      "layer": "Checker",
      "question": "Does this candidate solution satisfy the instance and objective contract?",
      "solverAllowed": true
    }
  ],
