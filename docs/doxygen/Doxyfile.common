# LotSizingDataModel - shared Doxygen configuration
# Validated design target: Doxygen 1.17.0
#
# Project-specific Doxyfiles include this file and override PROJECT_NAME,
# PROJECT_BRIEF, INPUT, OUTPUT_DIRECTORY, GENERATE_TAGFILE and main page.

DOXYFILE_ENCODING       = UTF-8
OUTPUT_LANGUAGE         = English

PROJECT_NAME            = "LotSizingDataModel"
PROJECT_NUMBER          = 1.0
PROJECT_BRIEF           = "C# framework for modeling, solving and validating lot-sizing problems"
PROJECT_LOGO            = docs/assets/doxygen-project-logo.png
PROJECT_ICON            = docs/assets/doxygen-project-icon.png

CREATE_SUBDIRS          = NO
ALLOW_UNICODE_NAMES     = YES
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = .
SHORT_NAMES             = NO

BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
ALWAYS_DETAILED_SEC     = NO
INLINE_INHERITED_MEMB   = NO
JAVADOC_AUTOBRIEF       = NO
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO

MARKDOWN_SUPPORT        = YES
MARKDOWN_STRICT         = YES
MARKDOWN_ID_STYLE       = GITHUB
AUTOLINK_SUPPORT        = YES
AUTOLINK_IGNORE_WORDS   = LotSizingDataModel
TOC_INCLUDE_HEADINGS    = 4

# C# / API extraction
EXTENSION_MAPPING       = cs=Csharp
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_PRIV_VIRTUAL    = NO
EXTRACT_PACKAGE         = YES
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
HIDE_UNDOC_NAMESPACES   = NO
HIDE_SCOPE_NAMES        = NO
HIDE_COMPOUND_REFERENCE = NO
SHOW_HEADERFILE         = NO
SHOW_INCLUDE_FILES      = NO
SHOW_USED_FILES         = YES
SHOW_FILES              = YES
SHOW_NAMESPACES         = YES
SORT_MEMBER_DOCS        = YES
SORT_BRIEF_DOCS         = YES
SORT_MEMBERS_CTORS_1ST  = YES
SORT_BY_SCOPE_NAME      = YES
ALPHABETICAL_INDEX      = YES

# Warnings
QUIET                   = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = NO
WARN_NO_PARAMDOC        = NO
WARN_AS_ERROR           = NO

# Inputs (overridden per project)
INPUT                   =
INPUT_ENCODING          = UTF-8
FILE_PATTERNS           = *.cs *.md
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */bin/* */obj/* */.vs/* */TestResults/* */Documentation/*
EXCLUDE_SYMLINKS        = YES
IMAGE_PATH              = docs/assets

# Source browsing / relations
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
STRIP_CODE_COMMENTS     = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
REFERENCES_LINK_SOURCE  = YES
USE_HTAGS               = NO

# HTML
GENERATE_HTML           = YES
HTML_OUTPUT             = html
HTML_FILE_EXTENSION     = .html
HTML_EXTRA_STYLESHEET   = docs/assets/doxygen-custom.css
HTML_DYNAMIC_MENUS      = YES
HTML_DYNAMIC_SECTIONS   = YES
HTML_INDEX_NUM_ENTRIES  = 100
DISABLE_INDEX           = YES
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = YES
TREEVIEW_WIDTH          = 300
SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO
EXTERNAL_SEARCH         = NO

# Other output formats are intentionally disabled.
GENERATE_LATEX          = NO
GENERATE_RTF            = NO
GENERATE_MAN            = NO
GENERATE_XML            = NO
GENERATE_DOCBOOK        = NO
GENERATE_AUTOGEN_DEF    = NO
GENERATE_PERLMOD        = NO

# Cross-project linking (injected by docs/build-documentation.ps1).
TAGFILES                =
GENERATE_TAGFILE        =

# Graphviz
HAVE_DOT                = YES
DOT_NUM_THREADS         = 0
CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES
GROUP_GRAPHS            = YES
UML_LOOK                = YES
UML_LIMIT_NUM_FIELDS    = 50
DOT_UML_DETAILS         = YES
DIRECTORY_GRAPH         = YES
DIR_GRAPH_MAX_DEPTH     = 2
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
DOT_GRAPH_MAX_NODES     = 100
MAX_DOT_GRAPH_DEPTH     = 2
GENERATE_LEGEND         = YES
DOT_CLEANUP             = YES

# Lists
GENERATE_TODOLIST       = YES
GENERATE_TESTLIST       = YES
GENERATE_BUGLIST        = YES
GENERATE_DEPRECATEDLIST = YES

# Deterministic output where practical
TIMESTAMP               = NO
